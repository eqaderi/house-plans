#!/usr/bin/env bash
# Run the houseplan CLI with the architecture Python environment.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
py="${HP_PYTHON:-$HOME/.venvs/architecture-ai/bin/python}"
if [ ! -x "$py" ]; then
  echo "No Python environment at $py. Run bin/doctor to see what is missing, then bin/setup." >&2
  exit 1
fi
PYTHONPATH="$here/src${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m houseplan "$@"
