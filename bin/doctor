#!/usr/bin/env bash
# What this machine has and what it is missing, with the command that fixes
# each gap. Works on a bare Mac (needs only bash and git).
#   bin/doctor           full report
#   bin/doctor --quiet   only problems (used at session start by Claude Code and Codex)
# Exit status 1 when something required is missing.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
quiet=0; [ "${1:-}" = "--quiet" ] && quiet=1
venv="${HP_VENV:-$HOME/.venvs/architecture-ai}"
py="${HP_PYTHON:-$venv/bin/python}"
required_missing=0
optional_missing=0

ok()   { [ $quiet -eq 1 ] || printf 'ok   %-14s %s\n' "$1" "$2"; }
miss() { # level name detail fix
  if [ "$1" = required ]; then required_missing=$((required_missing + 1)); tag="MISSING (required)"; else optional_missing=$((optional_missing + 1)); tag="missing (optional)"; fi
  printf '%-20s %-14s %s\n    fix: %s\n' "$tag" "$2" "$3" "$4"
}

# Tool path from config/tools.toml, overridden by config/tools.local.toml and HP_<KEY>.
tool() {
  local key="$1" v="" f
  for f in "$here/config/tools.toml" "$here/config/tools.local.toml"; do
    [ -f "$f" ] || continue
    local line; line="$(grep -E "^[[:space:]]*$key[[:space:]]*=" "$f" | tail -1)"
    [ -n "$line" ] && v="$(printf '%s' "$line" | sed -E 's/^[^=]*=[[:space:]]*"([^"]*)".*/\1/')"
  done
  local envname="HP_$(printf '%s' "$key" | tr '[:lower:]' '[:upper:]')"
  [ -n "${!envname:-}" ] && v="${!envname}"
  printf '%s' "${v/#\~/$HOME}"
}

# --- required -------------------------------------------------------------
if command -v git >/dev/null; then ok git "$(git --version)"; else miss required git "not found" "xcode-select --install"; fi

if [ -x "$py" ]; then
  report="$("$py" - "$here/requirements.txt" <<'PY' 2>&1
import sys
from importlib.metadata import version, PackageNotFoundError
bad = []
for line in open(sys.argv[1]):
    line = line.split("#")[0].strip()
    if not line:
        continue
    name, _, want = line.partition("==")
    name = name.split(">=")[0].strip()
    try:
        have = version(name)
    except PackageNotFoundError:
        bad.append(f"{name} not installed")
        continue
    if want and have != want.strip():
        bad.append(f"{name} {have} (project pins {want.strip()})")
print("; ".join(bad))
PY
)"
  if [ -z "$report" ]; then
    ok python "$("$py" --version 2>&1) at $venv, packages match requirements.txt"
  else
    miss required python-libs "$report" "bin/setup"
  fi
  if [ -x "$venv/bin/ifcmcp" ]; then ok ifcmcp "$venv/bin/ifcmcp"; else miss optional ifcmcp "IFC MCP server not installed" "bin/setup"; fi
else
  if command -v python3.13 >/dev/null || [ -x /opt/homebrew/bin/python3.13 ]; then
    miss required python-env "no environment at $venv" "bin/setup"
  else
    miss required python3.13 "not found" "brew install python@3.13 && bin/setup"
  fi
fi

# --- optional, per step -----------------------------------------------------
check_app() { # key label used-for fix
  local path; path="$(tool "$1")"
  if [ -n "$path" ] && [ -e "$path" ]; then ok "$2" "$path"; return; fi
  miss optional "$2" "not at ${path:-?} (needed for: $3)" "$4"
}
check_app oda      oda      "reading survey DWG files" "download from https://www.opendesign.com/guestfiles/oda_file_converter, drag to /Applications"
check_app blender  blender  "3D review of the IFC"    "brew install --cask blender"
check_app freecad  freecad  "CAD cross-checks"        "brew install --cask freecad"
check_app inkscape inkscape "presentation polish"     "brew install --cask inkscape"

qgis="$(tool qgis)"
if [ -e "$qgis" ]; then ok qgis "$qgis"
else
  found="$(ls -d /Applications/QGIS*.app/Contents/MacOS/qgis_process 2>/dev/null | head -1)"
  if [ -n "$found" ]; then
    miss optional qgis "installed at $found, not where config/tools.toml expects it" "add to config/tools.local.toml:  [tools]  qgis = \"$found\""
  else
    miss optional qgis "not found (needed for: terrain, contours, CRS)" "brew install --cask qgis"
  fi
fi

if ls -d "$HOME/Library/Application Support/Blender/"*/extensions/*/bonsai >/dev/null 2>&1; then ok bonsai "Blender extension"
else miss optional bonsai "Bonsai (IFC in Blender) not installed" "bin/setup --apps, or Blender > Preferences > Get Extensions > Bonsai"; fi

# --- agents and sync --------------------------------------------------------
if command -v claude >/dev/null || command -v codex >/dev/null; then
  ok agents "$(command -v claude >/dev/null && echo 'claude ')$(command -v codex >/dev/null && echo codex)"
else
  miss optional agents "neither Claude Code nor Codex CLI found" "npm i -g @anthropic-ai/claude-code   or   npm i -g @openai/codex"
fi
if git -C "$here" remote get-url origin >/dev/null 2>&1; then
  ok git-remote "$(git -C "$here" remote get-url origin)"
  behind="$(git -C "$here" rev-list --count HEAD..@{u} 2>/dev/null || echo 0)"
  [ "${behind:-0}" -gt 0 ] && miss optional git-sync "$behind commit(s) on the remote not pulled yet" "git pull"
else
  miss optional git-remote "no remote; work cannot move between laptops" "git remote add origin <url> && git push -u origin main"
fi
if [ -f "$here/sources/MANIFEST.sha256" ] && [ -s "$here/sources/MANIFEST.sha256" ]; then
  if (cd "$here" && shasum -a 256 -c --quiet sources/MANIFEST.sha256 >/dev/null 2>&1); then ok sources "all originals present and unchanged"
  else miss required sources "a file in sources/ is missing or changed" "copy the originals from the other laptop, then: shasum -a 256 -c sources/MANIFEST.sha256"; fi
fi

if [ $quiet -eq 0 ] || [ $((required_missing + optional_missing)) -gt 0 ]; then
  echo
  echo "$required_missing required and $optional_missing optional item(s) missing. Optional tools only block the steps that use them."
fi
[ $required_missing -eq 0 ]
