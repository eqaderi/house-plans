{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorKind": {
      "enum": [
        "human",
        "agent",
        "system"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "CodePackVerification": {
      "enum": [
        "unverified",
        "verified_by_professional",
        "verified_by_authority"
      ],
      "title": "CodePackVerification",
      "type": "string"
    },
    "CodeRule": {
      "additionalProperties": false,
      "properties": {
        "citation": {
          "title": "Citation",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "citation"
      ],
      "title": "CodeRule",
      "type": "object"
    }
  },
  "$id": "https://house-ai.local/schemas/codepack.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "minLength": 1,
      "title": "Authority",
      "type": "string"
    },
    "edition": {
      "minLength": 1,
      "title": "Edition",
      "type": "string"
    },
    "effective_date": {
      "format": "date",
      "title": "Effective Date",
      "type": "string"
    },
    "id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "jurisdiction": {
      "minLength": 1,
      "title": "Jurisdiction",
      "type": "string"
    },
    "rule_ids": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Rule Ids",
      "type": "array"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/CodeRule"
      },
      "title": "Rules",
      "type": "array"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "verification_status": {
      "$ref": "#/$defs/CodePackVerification",
      "default": "unverified"
    },
    "verified_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verified At"
    },
    "verified_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/Actor"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "jurisdiction",
    "authority",
    "edition",
    "effective_date",
    "source",
    "rule_ids"
  ],
  "title": "CodePack",
  "type": "object"
}
