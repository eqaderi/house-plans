{
  "$defs": {
    "AmbiguousEntity": {
      "additionalProperties": false,
      "description": "A CAD entity that could not be interpreted with confidence, and why.\n\nAmbiguous entities are reported and left out of the site model; they are\nnever silently used or dropped.",
      "properties": {
        "entity_type": {
          "title": "Entity Type",
          "type": "string"
        },
        "handle": {
          "title": "Handle",
          "type": "string"
        },
        "layer": {
          "title": "Layer",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "handle",
        "layer",
        "entity_type",
        "reason"
      ],
      "title": "AmbiguousEntity",
      "type": "object"
    },
    "ConfirmationStatus": {
      "description": "Status of a fact that must come from a source document or a human.\n\nUsed for drawing units, horizontal CRS and vertical datum. Nothing in the\nsystem may move a value to USER_CONFIRMED on its own; only a human can.",
      "enum": [
        "unknown",
        "declared_in_source",
        "user_confirmed",
        "local_only_confirmed"
      ],
      "title": "ConfirmationStatus",
      "type": "string"
    },
    "LengthUnit": {
      "enum": [
        "mm",
        "cm",
        "dm",
        "m",
        "km",
        "in",
        "ft",
        "us_survey_ft",
        "yd",
        "mi"
      ],
      "title": "LengthUnit",
      "type": "string"
    },
    "UnitDeclaration": {
      "additionalProperties": false,
      "description": "The length unit of a source drawing and how we know it.",
      "properties": {
        "status": {
          "$ref": "#/$defs/ConfirmationStatus",
          "default": "unknown"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/LengthUnit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "UnitDeclaration",
      "type": "object"
    }
  },
  "$id": "https://house-ai.local/schemas/cad_import.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Record of one CAD import (filled in by Milestone B adapters).",
  "properties": {
    "ambiguous_entities": {
      "items": {
        "$ref": "#/$defs/AmbiguousEntity"
      },
      "title": "Ambiguous Entities",
      "type": "array"
    },
    "boundary_handle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Boundary Handle"
    },
    "converted_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Converted Sha256"
    },
    "converter": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Converter"
    },
    "converter_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Converter Version"
    },
    "declared_epsg": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Declared Epsg"
    },
    "drawing_units": {
      "$ref": "#/$defs/UnitDeclaration"
    },
    "epsg": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Epsg"
    },
    "horizontal_crs_status": {
      "$ref": "#/$defs/ConfirmationStatus"
    },
    "layer_roles": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Layer Roles",
      "type": "object"
    },
    "local_origin": {
      "anyOf": [
        {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Local Origin"
    },
    "original_filename": {
      "title": "Original Filename",
      "type": "string"
    },
    "parser": {
      "title": "Parser",
      "type": "string"
    },
    "parser_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parser Version"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "source_document_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
      "title": "Source Document Id",
      "type": "string"
    },
    "source_format": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Format"
    },
    "unrecognized_entities": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Unrecognized Entities",
      "type": "object"
    },
    "unrecognized_layers": {
      "items": {
        "type": "string"
      },
      "title": "Unrecognized Layers",
      "type": "array"
    },
    "vertical_datum_status": {
      "$ref": "#/$defs/ConfirmationStatus"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "zero_elevation_is_valid": {
      "default": false,
      "title": "Zero Elevation Is Valid",
      "type": "boolean"
    }
  },
  "required": [
    "source_document_id",
    "original_filename",
    "sha256",
    "drawing_units",
    "parser",
    "horizontal_crs_status",
    "vertical_datum_status"
  ],
  "title": "CadImportProvenance",
  "type": "object"
}
