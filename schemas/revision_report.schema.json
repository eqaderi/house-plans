{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorKind": {
      "enum": [
        "human",
        "agent",
        "system"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "AreaChange": {
      "additionalProperties": false,
      "properties": {
        "after_m2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "After M2"
        },
        "before_m2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before M2"
        },
        "space_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Space Id",
          "type": "string"
        }
      },
      "required": [
        "space_id",
        "before_m2",
        "after_m2"
      ],
      "title": "AreaChange",
      "type": "object"
    },
    "ArtifactKind": {
      "description": "Kinds of versioned artifacts kept in a project store.",
      "enum": [
        "source_document",
        "cad_import",
        "site",
        "design_brief",
        "space_program",
        "assumptions",
        "open_questions",
        "constraint_set",
        "codepack",
        "plan",
        "evaluation_report",
        "revision_report",
        "build_record",
        "owner_statements"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Pointer to one immutable version of an artifact, pinned by content hash.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "MetricChange": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "After"
        },
        "before": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "before",
        "after"
      ],
      "title": "MetricChange",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/Actor"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Inputs",
          "type": "array"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "method"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "https://house-ai.local/schemas/revision_report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What changed between two plan versions, reported after every revision.",
  "properties": {
    "area_changes": {
      "items": {
        "$ref": "#/$defs/AreaChange"
      },
      "title": "Area Changes",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "from_version": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "geometry_changed": {
      "items": {
        "type": "string"
      },
      "title": "Geometry Changed",
      "type": "array"
    },
    "id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "metric_changes": {
      "items": {
        "$ref": "#/$defs/MetricChange"
      },
      "title": "Metric Changes",
      "type": "array"
    },
    "new_violations": {
      "items": {
        "type": "string"
      },
      "title": "New Violations",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "requested_change": {
      "title": "Requested Change",
      "type": "string"
    },
    "resolved_violations": {
      "items": {
        "type": "string"
      },
      "title": "Resolved Violations",
      "type": "array"
    },
    "rooms_added": {
      "items": {
        "type": "string"
      },
      "title": "Rooms Added",
      "type": "array"
    },
    "rooms_changed": {
      "items": {
        "type": "string"
      },
      "title": "Rooms Changed",
      "type": "array"
    },
    "rooms_removed": {
      "items": {
        "type": "string"
      },
      "title": "Rooms Removed",
      "type": "array"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "to_version": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "id",
    "requested_change",
    "from_version",
    "to_version",
    "provenance"
  ],
  "title": "RevisionReport",
  "type": "object"
}
