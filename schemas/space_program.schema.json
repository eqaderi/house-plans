{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorKind": {
      "enum": [
        "human",
        "agent",
        "system"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "ArtifactKind": {
      "description": "Kinds of versioned artifacts kept in a project store.",
      "enum": [
        "source_document",
        "cad_import",
        "site",
        "design_brief",
        "space_program",
        "assumptions",
        "open_questions",
        "constraint_set",
        "codepack",
        "plan",
        "evaluation_report",
        "revision_report",
        "build_record",
        "interview_session",
        "owner_statements",
        "concept_proposal"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Pointer to one immutable version of an artifact, pinned by content hash.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "DaylightNeed": {
      "enum": [
        "required",
        "preferred",
        "not_needed"
      ],
      "title": "DaylightNeed",
      "type": "string"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "minimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "Priority": {
      "enum": [
        "must",
        "should",
        "could",
        "wont"
      ],
      "title": "Priority",
      "type": "string"
    },
    "Privacy": {
      "enum": [
        "public",
        "semi_private",
        "private",
        "service"
      ],
      "title": "Privacy",
      "type": "string"
    },
    "ProgramZone": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "privacy": {
          "$ref": "#/$defs/Privacy"
        }
      },
      "required": [
        "id",
        "name",
        "privacy"
      ],
      "title": "ProgramZone",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/Actor"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Inputs",
          "type": "array"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "method"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SpaceFunction": {
      "enum": [
        "entry",
        "hall",
        "corridor",
        "living",
        "family",
        "reception",
        "dining",
        "kitchen",
        "pantry",
        "bedroom",
        "bathroom",
        "wc",
        "ablution",
        "prayer",
        "study",
        "gym",
        "play",
        "storage",
        "laundry",
        "mechanical",
        "garage",
        "stair",
        "lift",
        "guest_suite",
        "terrace",
        "balcony",
        "other"
      ],
      "title": "SpaceFunction",
      "type": "string"
    },
    "SpaceRelationship": {
      "additionalProperties": false,
      "description": "How two spaces should relate (GLOSSARY.md).",
      "properties": {
        "a": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "A",
          "type": "string"
        },
        "b": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "B",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SpaceRelationshipKind"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "source_fact_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Source Fact Ids",
          "type": "array"
        },
        "strength": {
          "$ref": "#/$defs/Strength"
        },
        "weight": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        }
      },
      "required": [
        "id",
        "a",
        "b",
        "kind",
        "strength"
      ],
      "title": "SpaceRelationship",
      "type": "object"
    },
    "SpaceRelationshipKind": {
      "enum": [
        "connected",
        "adjacent",
        "near",
        "visual",
        "separated",
        "acoustic_separation"
      ],
      "title": "SpaceRelationshipKind",
      "type": "string"
    },
    "SpaceRequirement": {
      "additionalProperties": false,
      "description": "A kind of space the Owner needs, with a quantity and a size (GLOSSARY.md).",
      "properties": {
        "accessible": {
          "default": false,
          "title": "Accessible",
          "type": "boolean"
        },
        "daylight": {
          "$ref": "#/$defs/DaylightNeed",
          "default": "preferred"
        },
        "function": {
          "$ref": "#/$defs/SpaceFunction"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "level_preference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level Preference"
        },
        "max_area_m2": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Area M2"
        },
        "min_area_m2": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Area M2"
        },
        "min_width_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Width M"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "priority": {
          "$ref": "#/$defs/Priority",
          "default": "must"
        },
        "privacy": {
          "$ref": "#/$defs/Privacy"
        },
        "quantity": {
          "default": 1,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "source_fact_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Source Fact Ids",
          "type": "array"
        },
        "target_area_m2": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Area M2"
        },
        "zone_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zone Id"
        }
      },
      "required": [
        "id",
        "name",
        "function",
        "privacy"
      ],
      "title": "SpaceRequirement",
      "type": "object"
    },
    "Strength": {
      "enum": [
        "hard",
        "soft"
      ],
      "title": "Strength",
      "type": "string"
    },
    "UsabilityRequirements": {
      "additionalProperties": false,
      "properties": {
        "arrival_path": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival Path"
        },
        "double_bed_space_requirement_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Double Bed Space Requirement Ids",
          "type": "array"
        },
        "household_seats": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Household Seats"
        },
        "single_bed_space_requirement_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Single Bed Space Requirement Ids",
          "type": "array"
        },
        "vehicles": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/VehicleEnvelope"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vehicles"
        }
      },
      "title": "UsabilityRequirements",
      "type": "object"
    },
    "VehicleEnvelope": {
      "additionalProperties": false,
      "description": "Requested vehicle size; not a turning-radius or swept-path model.",
      "properties": {
        "door_side_clearance_m": {
          "exclusiveMinimum": 0,
          "title": "Door Side Clearance M",
          "type": "number"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "length_m": {
          "exclusiveMinimum": 0,
          "title": "Length M",
          "type": "number"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "turning_radius_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turning Radius M"
        },
        "width_m": {
          "exclusiveMinimum": 0,
          "title": "Width M",
          "type": "number"
        }
      },
      "required": [
        "id",
        "width_m",
        "length_m",
        "door_side_clearance_m",
        "source"
      ],
      "title": "VehicleEnvelope",
      "type": "object"
    }
  },
  "$id": "https://house-ai.local/schemas/space_program.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The space requirements and relationships the program gate approves.\n\nOld field names (``items``, ``adjacencies``, ``levels``, ``site_verified``)\nare accepted on input; ``levels`` changed meaning, so only on schema 0.1.0.\nA record of schema 0.1.0 is written back with them, so programs saved before\nADR 0025 keep their content hash.",
  "properties": {
    "brief_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "budget": {
      "anyOf": [
        {
          "$ref": "#/$defs/Money"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "circulation_factor": {
      "anyOf": [
        {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Circulation Factor"
    },
    "id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema_version": {
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "site_approved": {
      "default": false,
      "title": "Site Approved",
      "type": "boolean"
    },
    "site_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "space_relationships": {
      "items": {
        "$ref": "#/$defs/SpaceRelationship"
      },
      "title": "Space Relationships",
      "type": "array"
    },
    "space_requirements": {
      "items": {
        "$ref": "#/$defs/SpaceRequirement"
      },
      "minItems": 1,
      "title": "Space Requirements",
      "type": "array"
    },
    "storeys": {
      "anyOf": [
        {
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Storeys"
    },
    "target_gross_area_m2": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Gross Area M2"
    },
    "usability": {
      "$ref": "#/$defs/UsabilityRequirements"
    },
    "zones": {
      "items": {
        "$ref": "#/$defs/ProgramZone"
      },
      "title": "Zones",
      "type": "array"
    }
  },
  "required": [
    "id",
    "project_id",
    "space_requirements",
    "provenance"
  ],
  "title": "SpaceProgram",
  "type": "object"
}
