            },
            {
              "$ref": "#/$defs/PolylineGeometry"
            },
            {
              "$ref": "#/$defs/PolygonGeometry"
            }
          ],
          "title": "Geometry"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SiteFeatureKind"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        },
        "status": {
          "$ref": "#/$defs/Epistemic",
          "default": "verified_fact"
        }
      },
      "required": [
        "id",
        "kind",
        "geometry"
