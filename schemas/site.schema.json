    "TinSurface": {
      "additionalProperties": false,
      "description": "Triangulated terrain built only from surveyed points (LOCAL metres).\n\nIt covers the convex hull of the survey data and nothing more: elevations\noutside it are unknown, never extrapolated.",
      "properties": {
        "method": {
          "const": "delaunay_tin",
          "default": "delaunay_tin",
          "title": "Method",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "triangles": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "minItems": 1,
          "title": "Triangles",
          "type": "array"
        },
        "vertices": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 3,
          "title": "Vertices",
          "type": "array"
        }
      },
      "required": [
        "vertices",
        "triangles"
      ],
      "title": "TinSurface",
      "type": "object"
    },
    "UnitDeclaration": {
