        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "status": {
          "$ref": "#/$defs/ConfirmationStatus",
          "default": "unknown"
        }
      },
      "title": "VerticalDatum",
      "type": "object"
    }
  },
