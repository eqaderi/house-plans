{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorKind": {
      "enum": [
        "human",
        "agent",
        "system"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "AdjacencyKind": {
      "enum": [
        "connected",
        "adjacent",
        "near",
        "visual",
        "separated",
        "acoustic_separation"
      ],
      "title": "AdjacencyKind",
      "type": "string"
    },
    "ArtifactKind": {
      "description": "Kinds of versioned artifacts kept in a project store.",
      "enum": [
        "source_document",
        "cad_import",
        "site",
        "design_brief",
        "space_program",
        "assumptions",
        "open_questions",
        "constraint_set",
        "codepack",
        "plan",
        "evaluation_report",
        "revision_report",
        "build_record",
        "interview_session",
        "owner_statements",
        "concept_proposal"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Pointer to one immutable version of an artifact, pinned by content hash.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "OutdoorLinkProposal": {
      "additionalProperties": false,
      "description": "Proposed connection between an interior space and an outdoor feature.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "terrace",
          "title": "Kind",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "program_item_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Program Item Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "program_item_id"
      ],
      "title": "OutdoorLinkProposal",
      "type": "object"
    },
    "Privacy": {
      "enum": [
        "public",
        "semi_private",
        "private",
        "service"
      ],
      "title": "Privacy",
      "type": "string"
    },
    "ProposalAdjacency": {
      "additionalProperties": false,
      "description": "Adjacency or connection relationship proposed between two spaces.",
      "properties": {
        "a": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "A",
          "type": "string"
        },
        "b": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "B",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AdjacencyKind",
          "default": "adjacent"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "strength": {
          "$ref": "#/$defs/Strength",
          "default": "soft"
        },
        "weight": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        }
      },
      "required": [
        "id",
        "a",
        "b"
      ],
      "title": "ProposalAdjacency",
      "type": "object"
    },
    "ProposalLevelAssignment": {
      "additionalProperties": false,
      "description": "Assignment of a program item to a specific storey or elevation tier.",
      "properties": {
        "level_id": {
          "minLength": 1,
          "title": "Level Id",
          "type": "string"
        },
        "program_item_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Program Item Id",
          "type": "string"
        }
      },
      "required": [
        "program_item_id",
        "level_id"
      ],
      "title": "ProposalLevelAssignment",
      "type": "object"
    },
    "ProposalZone": {
      "additionalProperties": false,
      "description": "A thematic functional zone grouping spaces in a concept proposal.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "privacy": {
          "anyOf": [
            {
              "$ref": "#/$defs/Privacy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "program_item_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Program Item Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ProposalZone",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/Actor"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Inputs",
          "type": "array"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "method"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "StairCoreProposal": {
      "additionalProperties": false,
      "description": "Proposed vertical circulation core and its target location.",
      "properties": {
        "connects_levels": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Connects Levels",
          "type": "array"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "near_program_item_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Near Program Item Ids",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "position": {
          "default": "central",
          "title": "Position",
          "type": "string"
        }
      },
      "required": [
        "id",
        "connects_levels"
      ],
      "title": "StairCoreProposal",
      "type": "object"
    },
    "Strength": {
      "enum": [
        "hard",
        "soft"
      ],
      "title": "Strength",
      "type": "string"
    }
  },
  "$id": "https://house-ai.local/schemas/concept_proposal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A typed topology proposal submitted by an agent or human.\n\nSpecifies high-level architectural intentions without hard-coded coordinates,\nallowing the solver to explore and optimize physical placement.",
  "properties": {
    "adjacency_graph": {
      "items": {
        "$ref": "#/$defs/ProposalAdjacency"
      },
      "title": "Adjacency Graph",
      "type": "array"
    },
    "id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "intent": {
      "minLength": 1,
      "title": "Intent",
      "type": "string"
    },
    "level_assignments": {
      "items": {
        "$ref": "#/$defs/ProposalLevelAssignment"
      },
      "title": "Level Assignments",
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "outdoor_links": {
      "items": {
        "$ref": "#/$defs/OutdoorLinkProposal"
      },
      "title": "Outdoor Links",
      "type": "array"
    },
    "project_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stair_cores": {
      "items": {
        "$ref": "#/$defs/StairCoreProposal"
      },
      "title": "Stair Cores",
      "type": "array"
    },
    "target_strategy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Strategy"
    },
    "zones": {
      "items": {
        "$ref": "#/$defs/ProposalZone"
      },
      "title": "Zones",
      "type": "array"
    }
  },
  "required": [
    "id",
    "project_id",
    "name",
    "intent"
  ],
  "title": "ConceptProposal",
  "type": "object"
}
