{
  "$defs": {
    "RevisionComment": {
      "additionalProperties": false,
      "description": "A comment on a specific canonical model element or plan.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "element_id": {
          "minLength": 1,
          "title": "Element Id",
          "type": "string"
        },
        "element_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element Kind"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "element_id",
        "text"
      ],
      "title": "RevisionComment",
      "type": "object"
    },
    "RevisionOp": {
      "additionalProperties": false,
      "description": "One structured revision operation matching plan revise arguments.",
      "properties": {
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "op_type": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Op Type",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "op_type",
        "target"
      ],
      "title": "RevisionOp",
      "type": "object"
    }
  },
  "$id": "https://house-ai.local/schemas/revision_ops.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "File exchanged between the reviewer UI and house-ai plan revise.",
  "properties": {
    "author": {
      "minLength": 1,
      "title": "Author",
      "type": "string"
    },
    "comments": {
      "items": {
        "$ref": "#/$defs/RevisionComment"
      },
      "title": "Comments",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/RevisionOp"
      },
      "title": "Operations",
      "type": "array"
    },
    "option": {
      "minLength": 1,
      "title": "Option",
      "type": "string"
    },
    "plan_version": {
      "minimum": 1,
      "title": "Plan Version",
      "type": "integer"
    },
    "project": {
      "minLength": 1,
      "title": "Project",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "verbatim_request": {
      "minLength": 1,
      "title": "Verbatim Request",
      "type": "string"
    }
  },
  "required": [
    "project",
    "option",
    "plan_version",
    "verbatim_request",
    "author"
  ],
  "title": "RevisionOpsFile",
  "type": "object"
}
