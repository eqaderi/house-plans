{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorKind": {
      "enum": [
        "human",
        "agent",
        "system"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "ArtifactKind": {
      "description": "Kinds of versioned artifacts kept in a project store.",
      "enum": [
        "source_document",
        "cad_import",
        "site",
        "design_brief",
        "space_program",
        "assumptions",
        "open_questions",
        "constraint_set",
        "codepack",
        "plan",
        "evaluation_report",
        "revision_report",
        "build_record",
        "interview_session",
        "owner_statements"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Pointer to one immutable version of an artifact, pinned by content hash.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "affects": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Affects",
          "type": "array"
        },
        "basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        },
        "confirm_with": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirm With"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "made_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Actor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Epistemic",
          "default": "assumption"
        }
      },
      "required": [
        "id",
        "statement"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Epistemic": {
      "description": "Epistemic status of a statement about the project.",
      "enum": [
        "verified_fact",
        "inference",
        "assumption",
        "preference",
        "simulation_result",
        "professional_approval",
        "unknown"
      ],
      "title": "Epistemic",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/Actor"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Inputs",
          "type": "array"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "method"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "https://house-ai.local/schemas/assumptions.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "assumptions.yaml",
  "properties": {
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "project_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "provenance"
  ],
  "title": "AssumptionsFile",
  "type": "object"
}
